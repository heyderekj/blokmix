{
  "name": "blokmix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:laravel": "concurrently -k -n php,vite -c \"#93c5fd,#ff6aa8\" \"php artisan serve\" \"BLOKMIX_HOST=laravel vite\"",
    "build": "tsc --noEmit && vite build",
    "build:laravel": "tsc --noEmit && BLOKMIX_HOST=laravel vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "test": "vitest run",
    "export:demo": "vite-node scripts/export-demo.ts",
    "mcp": "vite-node scripts/mcp-bridge.ts",
    "extension:build": "vite build -c extension/vite.config.ts && vite build -c extension/vite.content.config.ts",
    "extension:fixtures": "vite-node extension/scripts/capture-fixtures.ts",
    "clip:add": "vite-node scripts/clip-add.ts"
  },
  "dependencies": {
    "@inertiajs/react": "^3.9.1",
    "@paper-design/shaders": "^0.0.82",
    "d3-contour": "^4.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "parse5": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplex-noise": "^4.0.3",
    "zod": "^4.6.7",
    "zundo": "^2.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@phosphor-icons/core": "2.1.1",
    "@tabler/icons": "3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "heroicons": "2.2.0",
    "laravel-vite-plugin": "^3.2.0",
    "lucide-static": "1.53.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
