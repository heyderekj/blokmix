{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "blokmix",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "blokmix-app",
      "url": "http://localhost:8000"
    },
    {
      "name": "blokmix-site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "/Users/heyderekj/blokmix.com",
        "run",
        "dev",
        "--",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "blokmix-worktree",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd public && exec php -d upload_max_filesize=256M -d post_max_size=256M -S 127.0.0.1:8001 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"
      ],
      "port": 8001
    }
  ]
}
