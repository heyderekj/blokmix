{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "blokmix.return/v1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "base": {
      "$ref": "#/$defs/__schema0"
    },
    "mix": {
      "$ref": "#/$defs/__schema0"
    },
    "draft": {
      "$ref": "#/$defs/__schema0"
    },
    "agent": {
      "$ref": "#/$defs/__schema0"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "preview": {
      "type": "string",
      "format": "uri"
    },
    "changes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "format",
    "id",
    "agent",
    "summary",
    "changes"
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "add"
            },
            "page": {
              "$ref": "#/$defs/__schema0"
            },
            "section": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"
            },
            "recipe": {
              "$ref": "#/$defs/__schema2"
            },
            "words": {
              "$ref": "#/$defs/__schema8"
            }
          },
          "required": [
            "kind",
            "page",
            "section",
            "recipe"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "color"
            },
            "token": {
              "type": "string",
              "enum": [
                "color.bg",
                "color.surface",
                "color.text",
                "color.muted",
                "color.border",
                "color.primary",
                "color.onPrimary",
                "color.accent"
              ]
            },
            "value": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "required": [
            "kind",
            "token",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "layout"
            },
            "section": {
              "$ref": "#/$defs/__schema0"
            },
            "recipe": {
              "$ref": "#/$defs/__schema2"
            }
          },
          "required": [
            "kind",
            "section",
            "recipe"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "media"
            },
            "section": {
              "$ref": "#/$defs/__schema0"
            },
            "block": {
              "$ref": "#/$defs/__schema9"
            },
            "value": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "const": "placeholder"
                    },
                    "style": {
                      "type": "string",
                      "enum": [
                        "bakery",
                        "table-setting",
                        "print-studio",
                        "courtyard",
                        "reading-room",
                        "ceramics",
                        "mountain-trail",
                        "bread-counter",
                        "pottery-shelf",
                        "trail-map",
                        "print-edition",
                        "balance-book",
                        "day-ticket",
                        "mesh",
                        "shapes",
                        "arch",
                        "waves",
                        "grid",
                        "portrait",
                        "grain-gradient",
                        "dither",
                        "halftone",
                        "topo",
                        "flow",
                        "blocks",
                        "ascii",
                        "op-art",
                        "marble"
                      ]
                    },
                    "alt": {
                      "$ref": "#/$defs/__schema0"
                    }
                  },
                  "required": [
                    "source",
                    "style"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "const": "upload"
                    },
                    "asset": {
                      "type": "string",
                      "pattern": "^img_[a-z0-9]{1,12}$"
                    },
                    "alt": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "fit": {
                      "type": "string",
                      "enum": [
                        "cover",
                        "contain"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "asset"
                  ]
                }
              ]
            }
          },
          "required": [
            "kind",
            "section",
            "block",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "word"
            },
            "section": {
              "$ref": "#/$defs/__schema0"
            },
            "field": {
              "$ref": "#/$defs/__schema5"
            },
            "value": {
              "type": "string",
              "maxLength": 3000
            }
          },
          "required": [
            "kind",
            "section",
            "field",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spacing"
            },
            "section": {
              "$ref": "#/$defs/__schema0"
            },
            "edge": {
              "type": "string",
              "enum": [
                "top",
                "bottom"
              ]
            },
            "value": {
              "type": "string",
              "enum": [
                "none",
                "tight",
                "default",
                "roomy"
              ]
            }
          },
          "required": [
            "kind",
            "section",
            "edge",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "surface"
            },
            "section": {
              "$ref": "#/$defs/__schema0"
            },
            "value": {
              "type": "string",
              "enum": [
                "page",
                "brand",
                "soft",
                "inverse"
              ]
            }
          },
          "required": [
            "kind",
            "section",
            "value"
          ]
        }
      ]
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "nav",
            "hero",
            "header",
            "logos",
            "features",
            "stats",
            "content",
            "gallery",
            "team",
            "testimonials",
            "pricing",
            "blog",
            "faq",
            "contact",
            "cta",
            "footer"
          ]
        },
        "title": {
          "$ref": "#/$defs/__schema0"
        },
        "layout": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "clip": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "required": [
                "clip"
              ]
            },
            {
              "type": "object",
              "properties": {
                "rows": {
                  "minItems": 1,
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema3"
                  }
                }
              },
              "required": [
                "rows"
              ]
            }
          ]
        },
        "controls": {
          "default": [],
          "maxItems": 12,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        }
      },
      "required": [
        "type",
        "title",
        "layout"
      ]
    },
    "__schema3": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      }
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "field": {
          "$ref": "#/$defs/__schema5"
        },
        "kind": {
          "type": "string",
          "enum": [
            "heading",
            "text",
            "badge",
            "button"
          ]
        }
      },
      "required": [
        "field",
        "kind"
      ]
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,45}$"
    },
    "__schema6": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "choice"
            },
            "label": {
              "$ref": "#/$defs/__schema0"
            },
            "options": {
              "minItems": 2,
              "maxItems": 12,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema7"
              }
            }
          },
          "required": [
            "kind",
            "label",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "toggle"
            },
            "label": {
              "$ref": "#/$defs/__schema0"
            },
            "options": {
              "type": "array",
              "prefixItems": [
                {
                  "$ref": "#/$defs/__schema7"
                },
                {
                  "$ref": "#/$defs/__schema7"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "kind",
            "label",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            },
            "label": {
              "$ref": "#/$defs/__schema0"
            },
            "block": {
              "type": "string",
              "pattern": "^b\\d+$"
            }
          },
          "required": [
            "kind",
            "label",
            "block"
          ]
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/__schema0"
        },
        "words": {
          "$ref": "#/$defs/__schema8"
        },
        "blocks": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema9"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "fill": {
                "$ref": "#/$defs/__schema10"
              },
              "ink": {
                "$ref": "#/$defs/__schema10"
              },
              "radius": {
                "type": "string",
                "enum": [
                  "none",
                  "sm",
                  "md",
                  "lg",
                  "pill"
                ]
              },
              "shadow": {
                "type": "string",
                "enum": [
                  "none",
                  "soft",
                  "lifted",
                  "offset"
                ]
              }
            }
          }
        },
        "surface": {
          "type": "string",
          "enum": [
            "page",
            "brand",
            "inverse",
            "soft"
          ]
        }
      },
      "required": [
        "label",
        "words"
      ]
    },
    "__schema8": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema5"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 3000
      }
    },
    "__schema9": {
      "type": "string",
      "pattern": "^b\\d+$"
    },
    "__schema10": {
      "type": "string",
      "enum": [
        "primary",
        "accent",
        "surface",
        "bg",
        "text",
        "muted",
        "border",
        "onPrimary"
      ]
    }
  }
}
