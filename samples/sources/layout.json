{
  "id": "layout",
  "kind": "layout",
  "name": "Blokmix layout",
  "url": "https://blokmix.example/layouts/",
  "personality": "Blokmix's built-in layouts: plain structure, like a wireframe. Grey, hairlines, boxes where pictures go. The skin brings the look.",
  "tokens": {
    "color.bg": "#fafafa",
    "color.surface": "#ededed",
    "color.text": "#262626",
    "color.muted": "#6b6b6b",
    "color.border": "#d4d4d4",
    "color.primary": "#404040",
    "color.onPrimary": "#fafafa",
    "color.accent": "#8a8a8a",
    "font.display": "'Inter', system-ui, sans-serif",
    "font.body": "'Inter', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "650",
    "radius.base": "10px",
    "stroke.width": "1px",
    "icon.set": "lucide:regular",
    "shadow.card": "0 1px 2px #18181b0f, 0 8px 24px #18181b0f",
    "space.base": "4px",
    "space.content": "1200px",
    "space.text": "760px",
    "space.section": "96px",
    "motion.duration": "320ms",
    "motion.ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "fonts": [
    {
      "family": "Inter",
      "css2": "Inter:wght@400..700"
    },
    {
      "family": "JetBrains Mono",
      "css2": "JetBrains+Mono:wght@400;500"
    }
  ]
}
