{
  "id": "layout",
  "kind": "layout",
  "name": "Mixtape layout",
  "url": "https://mixtape.example/layouts/",
  "personality": "Mixtape's built-in layouts: polished and neutral. Clean Inter type, near-black ink on white, soft 10px corners, generous spacing, one quiet pink accent. Structure first, so your style guide can take over.",
  "tokens": {
    "color.bg": "#ffffff",
    "color.surface": "#f5f5f4",
    "color.text": "#18181b",
    "color.muted": "#6b6b70",
    "color.border": "#e7e5e4",
    "color.primary": "#18181b",
    "color.onPrimary": "#ffffff",
    "color.accent": "#e2508d",
    "font.display": "'Inter', system-ui, sans-serif",
    "font.body": "'Inter', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "650",
    "radius.base": "10px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 2px #18181b0f, 0 8px 24px #18181b0f",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "320ms",
    "motion.ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "fonts": [
    {
      "family": "Inter",
      "css2": "Inter:wght@400..700"
    },
    {
      "family": "JetBrains Mono",
      "css2": "JetBrains+Mono:wght@400;500"
    }
  ]
}
