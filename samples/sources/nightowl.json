{
  "id": "nightowl",
  "kind": "site",
  "name": "Nightowl",
  "url": "https://nightowl.example/",
  "personality": "Dark developer tool: near-black panels, neon green signal color, tight grotesk display, monospace details, glowing borders, terminal-like precision.",
  "tokens": {
    "color.bg": "#0b0d0e",
    "color.surface": "#14181a",
    "color.text": "#e8f0ec",
    "color.muted": "#8a9a93",
    "color.border": "#252d30",
    "color.primary": "#3dff8f",
    "color.onPrimary": "#04140b",
    "color.accent": "#7cc7ff",
    "font.display": "'Inter Tight', 'Inter', system-ui, sans-serif",
    "font.body": "'Inter', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "15px",
    "type.ratio": "1.25",
    "type.displayWeight": "600",
    "radius.base": "10px",
    "shadow.card": "0 0 0 1px #252d30, 0 20px 40px #00000066",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "240ms",
    "motion.ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "fonts": [
    {
      "family": "Inter Tight",
      "css2": "Inter+Tight:wght@400..800"
    },
    {
      "family": "Inter",
      "css2": "Inter:wght@400..700"
    },
    {
      "family": "JetBrains Mono",
      "css2": "JetBrains+Mono:wght@400;500;700"
    }
  ]
}
