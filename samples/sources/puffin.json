{
  "id": "puffin",
  "name": "Puffin",
  "url": "https://puffin.example/",
  "personality": "Soft, friendly SaaS: lavender whites, violet-to-peach gradients, big round corners, chunky geometric sans, floaty cards with bouncy springs.",
  "tokens": {
    "color.bg": "#fdfcff",
    "color.surface": "#f3effe",
    "color.text": "#1e1b3a",
    "color.muted": "#6e6a8a",
    "color.border": "#e6e1f7",
    "color.primary": "#7c5cff",
    "color.onPrimary": "#ffffff",
    "color.accent": "#ff8a65",
    "font.display": "'Plus Jakarta Sans', system-ui, sans-serif",
    "font.body": "'Plus Jakarta Sans', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "800",
    "radius.base": "20px",
    "shadow.card": "0 2px 4px #1e1b3a0d, 0 12px 32px #7c5cff1f",
    "space.base": "4px",
    "space.section": "104px",
    "motion.duration": "420ms",
    "motion.ease": "cubic-bezier(0.34, 1.56, 0.64, 1)"
  },
  "fonts": [
    { "family": "Plus Jakarta Sans", "css2": "Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800" },
    { "family": "JetBrains Mono", "css2": "JetBrains+Mono:wght@400;500;700" }
  ]
}
