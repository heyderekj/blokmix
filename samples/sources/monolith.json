{
  "id": "monolith",
  "kind": "site",
  "name": "Monolith Supply",
  "url": "https://monolith.example/",
  "personality": "Brutalist hardware store: white paper, 2px black rules, hi-vis yellow, square corners, hard offset shadows, mono body, snappy unapologetic motion.",
  "tokens": {
    "color.bg": "#ffffff",
    "color.surface": "#f2f2ee",
    "color.text": "#000000",
    "color.muted": "#555555",
    "color.border": "#000000",
    "color.primary": "#ffe600",
    "color.onPrimary": "#000000",
    "color.accent": "#ff3b00",
    "font.display": "'Archivo Black', 'Arial Black', sans-serif",
    "font.body": "'Space Mono', ui-monospace, monospace",
    "font.mono": "'Space Mono', ui-monospace, monospace",
    "type.base": "15px",
    "type.ratio": "1.5",
    "type.displayWeight": "400",
    "radius.base": "0px",
    "shadow.card": "6px 6px 0 #000000",
    "space.base": "4px",
    "space.section": "80px",
    "motion.duration": "140ms",
    "motion.ease": "cubic-bezier(0, 0, 1, 1)"
  },
  "fonts": [
    {
      "family": "Archivo Black",
      "css2": "Archivo+Black"
    },
    {
      "family": "Space Mono",
      "css2": "Space+Mono:ital,wght@0,400;0,700;1,400"
    }
  ]
}
