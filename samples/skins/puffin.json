        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "cta": {
      "backdrop": {
        "id": "mesh",
        "params": {
          "anchor": "bottom",
          "reach": 90
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "stats": {
