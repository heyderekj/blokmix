{
  "name": "Dream Pop",
  "words": "Soft and floaty: lavender, peach, round corners.",
  "mode": "light",
  "feel": [
    "playful",
    "calm",
    "modern"
  ],
  "tokens": {
    "icon.set": "material:fill",
    "color.bg": "#fdfcff",
    "color.surface": "#f3effe",
    "color.text": "#1e1b3a",
    "color.muted": "#6e6a8a",
    "color.border": "#e6e1f7",
    "color.primary": "#6f4ff2",
    "color.onPrimary": "#ffffff",
    "color.accent": "#ff8a65",
    "font.display": "'Plus Jakarta Sans', system-ui, sans-serif",
    "font.body": "'Plus Jakarta Sans', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "800",
    "radius.base": "20px",
    "stroke.width": "1px",
    "shadow.card": "0 2px 4px #1e1b3a0d, 0 12px 32px #7c5cff1f",
    "space.base": "4px",
    "space.section": "104px",
    "motion.duration": "280ms",
    "motion.ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "space.content": "1176px",
    "space.text": "672px"
  },
  "effects": {
    "gradient": {
      "id": "gradient",
      "params": {
        "shape": "radial",
        "stops": [
          "accent",
          "primary",
          "surface"
        ]
      }
    },
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 18,
        "softness": 80,
        "layers": 4,
        "opacity": 16,
        "tighten": 25
      }
    },
    "glow": {
      "id": "glow",
      "params": {
        "color": "accent",
        "size": 60,
        "strength": 30
      }
    }
  },
  "textStyles": {
    "label": {
      "weight": 700,
      "tracking": 0.01,
      "upper": false
    },
    "h1": {
      "tracking": -0.035,
      "leading": 1.08
    },
    "h2": {
      "tracking": -0.03,
      "leading": 1.15
    },
    "h3": {
      "weight": 700,
      "tracking": -0.02,
      "leading": 1.25
    },
    "h4": {
      "weight": 700,
      "tracking": -0.01,
      "leading": 1.3
    },
    "bodyLarge": {
      "weight": 500,
      "leading": 1.6
    },
    "small": {
      "weight": 500
    },
    "caption": {
      "weight": 500,
      "tracking": 0.01
    }
  },
  "components": {
    "badge": {
      "variant": "pill"
    },
    "card": {
      "variant": "glass"
    },
    "button": {
      "variant": "pill",
      "secondary": {
        "variant": "soft"
      }
    },
    "icon": {
      "variant": "tile"
    },
    "link": {
      "variant": "underline"
    },
    "input": {
      "variant": "outlined"
    }
  },
  "sections": {
    "hero": {
      "motion": {
        "mode": "preset",
        "enter": "blur",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "features": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "testimonials": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "backdrop": {
        "id": "mesh",
        "params": {
          "anchor": "bottom",
          "reach": 90
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    }
  },
  "picture": {
    "style": "mesh",
    "subjects": [
      "pottery-shelf",
      "ceramics",
      "print-edition",
      "cards"
    ],
    "mode": "image"
  },
  "industries": [
    "education",
    "ecommerce"
  ]
}
