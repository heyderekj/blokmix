{
  "name": "Technical",
  "words": "Dark, precise and calm under pressure, like a good dev tool.",
  "tier": "pack",
  "mode": "dark",
  "feel": ["dark", "modern", "serious"],
  "tokens": {
    "icon.set": "tabler:regular",
