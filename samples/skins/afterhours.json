{
  "name": "After Hours",
  "words": "Dark and precise, like a good dev tool.",
  "mode": "dark",
  "feel": [
    "dark",
    "modern",
    "serious"
  ],
  "tokens": {
    "icon.set": "tabler:regular",
    "color.bg": "#0a1015",
    "color.surface": "#141c22",
    "color.text": "#ebeff3",
    "color.muted": "#9fa6ab",
    "color.border": "#272f35",
    "color.primary": "#7cc7ff",
    "color.onPrimary": "#0a131a",
    "color.accent": "#e48da5",
    "font.display": "'Geist', system-ui, sans-serif",
    "font.body": "'Geist', system-ui, sans-serif",
    "font.mono": "'Geist Mono', ui-monospace, monospace",
    "type.base": "15px",
    "type.ratio": "1.2",
    "type.displayWeight": "600",
    "radius.base": "8px",
    "stroke.width": "1px",
    "shadow.card": "0 0 0 1px rgb(255 255 255 / 0.06), 0 20px 40px rgb(0 0 0 / 0.4)",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "240ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1152px",
    "space.text": "664px"
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 500,
      "tracking": 0.06
    },
    "h1": {
      "tracking": -0.04,
      "leading": 1.02
    },
    "h2": {
      "tracking": -0.035,
      "leading": 1.1
    },
    "h3": {
      "weight": 600,
      "tracking": -0.02,
      "leading": 1.2
    },
    "h4": {
      "weight": 500,
      "tracking": -0.01,
      "leading": 1.3
    },
    "bodyLarge": {
      "leading": 1.5,
      "tracking": -0.01
    },
    "small": {
      "leading": 1.45
    },
    "caption": {
      "font": "mono",
      "tracking": 0.02
    }
  },
  "components": {
    "badge": {
      "variant": "mono"
    },
    "card": {
      "variant": "bordered"
    },
    "button": {
      "variant": "inverse",
      "secondary": {
        "variant": "ghost"
      }
    },
    "icon": {
      "variant": "bare"
    },
    "link": {
      "variant": "mono"
    },
    "input": {
      "variant": "filled"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "grid"
      },
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "features": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "testimonials": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "backdrop": {
        "id": "spotlight",
        "params": {
          "color": "primary",
          "strength": 28,
          "size": 80,
          "anchor": "top",
          "reach": 90
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "blur",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "drop",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "nav": {
      "backdrop": {
        "id": "grid"
      }
    }
  },
  "picture": {
    "style": "dither",
    "subjects": [
      "analytics",
      "code",
      "dashboard",
      "table"
    ],
    "mode": "ui",
    "mockParams": {
      "tint": true,
      "chrome": "none",
      "inset": 6,
      "shadow": false
    }
  },
  "industries": [
    "devtools",
    "ai"
  ]
}
