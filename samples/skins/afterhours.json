{
  "name": "After Hours",
  "words": "Dark and precise, like a good dev tool.",
  "mode": "dark",
  "feel": [
    "dark",
    "modern",
    "serious"
  ],
  "tokens": {
    "icon.set": "tabler:regular",
    "color.bg": "#0a1015",
    "color.surface": "#141c22",
    "color.text": "#ebeff3",
    "color.muted": "#9fa6ab",
    "color.border": "#272f35",
    "color.primary": "#7cc7ff",
    "color.onPrimary": "#0a131a",
    "color.accent": "#e48da5",
    "font.display": "'Geist', system-ui, sans-serif",
    "font.body": "'Geist', system-ui, sans-serif",
    "font.mono": "'Geist Mono', ui-monospace, monospace",
    "type.base": "15px",
    "type.ratio": "1.25",
    "type.displayWeight": "600",
    "radius.base": "8px",
    "stroke.width": "1px",
    "shadow.card": "0 0 0 1px rgb(255 255 255 / 0.06), 0 20px 40px rgb(0 0 0 / 0.4)",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "240ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)"
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 500,
      "tracking": 0.06
    }
  },
  "components": {
    "badge": {
      "variant": "mono"
    },
    "card": {
      "variant": "bordered"
    },
    "button": {
      "secondary": {
        "variant": "ghost"
      }
    },
    "icon": {
      "variant": "bare"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "grid"
      },
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "features": {
      "motion": {
