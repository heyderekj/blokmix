{
  "name": "Friendly",
  "words": "Round, warm and a little playful.",
  "tier": "free",
  "mode": "light",
  "tokens": {
    "font.display": "'Plus Jakarta Sans', system-ui, sans-serif",
    "font.body": "'Plus Jakarta Sans', system-ui, sans-serif",
    "type.ratio": "1.25",
    "type.displayWeight": "800",
    "radius.base": "20px",
    "space.section": "104px",
    "shadow.card": "0 2px 4px rgb(30 27 58 / 0.05), 0 12px 32px rgb(30 27 58 / 0.08)",
    "motion.duration": "360ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "color.bg": "#fffcfa",
    "color.surface": "#fcf0eb",
    "color.text": "#221814",
    "color.muted": "#736661",
    "color.border": "#e9ddd8",
    "color.primary": "#a83607",
    "color.onPrimary": "#fffaf7",
    "color.accent": "#159e6d"
  },
  "effects": {
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 30,
        "softness": 90,
        "layers": 5,
        "opacity": 20,
        "tighten": 35
      }
    },
    "glass": {
      "id": "glass",
      "params": {
        "blur": 20,
        "fill": 55,
        "edge": 75
      }
    },
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "primary",
          "accent"
        ],
        "angle": 135
      }
    }
  },
  "components": {
    "badge": {
      "variant": "pill"
    },
    "card": {
      "variant": "raised"
    },
    "icon": {
      "variant": "accent"
    }
  },
  "sections": {
    "hero": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "normal"
      }
    },
    "features": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "normal"
      }
    },
    "testimonials": {
