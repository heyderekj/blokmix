{
  "name": "Homeroom",
  "words": "Indigo headings, rounded cards and a dotted ground.",
  "mode": "light",
  "feel": [
    "playful",
    "calm"
  ],
  "tokens": {
    "icon.set": "material:bold",
    "color.bg": "#f9faff",
    "color.surface": "#eceffa",
    "color.text": "#1a2038",
    "color.muted": "#5b6380",
    "color.border": "#d9deef",
    "color.primary": "#35458d",
    "color.onPrimary": "#ffffff",
    "color.accent": "#8c4627",
    "font.display": "'Outfit', sans-serif",
    "font.body": "'Source Sans 3', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.2",
    "type.displayWeight": "600",
    "radius.base": "18px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 2px rgb(26 32 56 / 0.06), 0 6px 16px rgb(53 69 141 / 0.1)",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "272ms",
    "motion.ease": "cubic-bezier(0.33, 1, 0.68, 1)",
    "space.content": "1180px",
    "space.text": "720px"
  },
  "effects": {
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "primary",
          "accent"
        ],
        "angle": 120
      }
    },
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 10,
        "softness": 50,
        "layers": 3,
        "opacity": 12,
        "tighten": 10
      }
    }
  },
  "textStyles": {
    "label": {
      "weight": 600,
      "tracking": 0.03,
      "upper": false,
      "size": "sm"
    },
    "h1": {
      "tracking": -0.02,
      "leading": 1.1
    },
    "h2": {
      "tracking": -0.015,
      "leading": 1.18
    },
    "h3": {
      "weight": 500,
      "tracking": -0.005,
      "leading": 1.28
    },
    "h4": {
      "weight": 500,
      "tracking": 0,
      "leading": 1.35
    },
    "bodyLarge": {
      "leading": 1.6
    },
    "small": {
      "leading": 1.5
    },
    "caption": {
      "weight": 600
    }
  },
  "components": {
    "badge": {
      "variant": "pill"
    },
    "card": {
      "variant": "raised"
    },
    "button": {
      "variant": "solid",
      "secondary": {
        "variant": "soft"
      }
    },
    "icon": {
      "variant": "tinted"
    },
    "link": {
      "variant": "underline"
    },
    "input": {
      "variant": "outlined"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "dots",
        "params": {
          "strength": 8
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "drop",
        "stagger": true,
        "onScroll": true
      }
    },
    "features": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "testimonials": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "surface": "inverse",
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "onScroll": true
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "onScroll": true
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    }
  },
  "picture": {
    "style": "waves",
    "subjects": [
      "day-ticket",
      "calendar",
      "cards",
      "chat"
    ],
    "mode": "ui",
    "mockParams": {
      "tint": true,
      "chrome": "none",
      "inset": 6,
      "shadow": false
    }
  },
  "industries": [
    "education",
    "other"
  ],
  "formats": [
    "business"
  ],
  "flavors": [
    {
      "id": "open-house",
      "name": "Homeroom · Open House",
      "industry": "other",
      "parts": {
        "shape": "lofi"
      }
    }
  ]
}
