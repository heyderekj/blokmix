{
  "name": "Homeroom",
  "words": "Indigo headings, rounded cards and a dotted ground.",
  "mode": "light",
  "feel": [
    "playful",
    "calm"
  ],
  "tokens": {
    "icon.set": "material:bold",
    "color.bg": "#fdfcff",
    "color.surface": "#f3effe",
    "color.text": "#1e1b3a",
    "color.muted": "#6e6a8a",
    "color.border": "#e6e1f7",
    "color.primary": "#35458d",
    "color.onPrimary": "#ffffff",
    "color.accent": "#8c4627",
    "font.display": "'Outfit', sans-serif",
    "font.body": "'Source Sans 3', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "600",
    "radius.base": "18px",
    "stroke.width": "1px",
    "shadow.card": "0 2px 4px #1e1b3a0d, 0 12px 32px #7c5cff1f",
    "space.base": "4px",
    "space.section": "96px",
    "motion.duration": "272ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1180px",
    "space.text": "720px"
  },
  "effects": {
    "gradient": {
      "id": "gradient",
      "params": {
        "shape": "radial",
        "stops": [
          "accent",
          "primary",
          "surface"
        ]
      }
    },
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 18,
        "softness": 80,
        "layers": 4,
        "opacity": 16,
        "tighten": 25
      }
    },
    "glow": {
      "id": "glow",
      "params": {
        "color": "accent",
        "size": 60,
        "strength": 30
      }
    }
  },
  "textStyles": {
    "label": {
      "weight": 700,
      "tracking": 0.01,
      "upper": false
    },
    "h2": {
      "tracking": -0.025
    },
    "h3": {
      "tracking": -0.01
    },
    "h4": {
      "tracking": -0.01
    }
  },
  "components": {
    "badge": {
      "variant": "pill"
    },
    "card": {
      "variant": "tinted"
    },
    "button": {
      "secondary": {
        "variant": "soft"
      }
    },
    "icon": {
      "variant": "bare"
    },
    "link": {
      "variant": "underline"
    },
    "input": {
      "variant": "filled"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "dots",
        "params": {
          "strength": 8
        }
      }
    },
    "features": {
      "surface": "soft"
    },
    "testimonials": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "surface": "inverse"
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    }
  },
  "picture": {
    "style": "waves",
    "subjects": [
      "day-ticket",
      "calendar",
      "cards",
      "chat"
    ],
    "mode": "ui",
    "mockParams": {
      "tint": true,
      "chrome": "none",
      "inset": 6,
      "shadow": false
    }
  },
  "industries": [
    "education",
    "other"
  ],
  "formats": [
    "business"
  ],
  "flavors": [
    {
      "id": "open-house",
      "name": "Homeroom · Open House",
      "industry": "other",
      "parts": {
        "shape": "lofi"
      }
    }
  ]
}
