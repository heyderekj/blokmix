{
  "name": "Mastered",
  "words": "Navy, compact headings and ruled cards keep the numbers clear.",
  "mode": "light",
  "feel": [
    "serious",
    "modern"
  ],
  "tokens": {
    "icon.set": "lucide:regular",
    "color.bg": "#ffffff",
    "color.surface": "#f4f5f7",
    "color.text": "#0c0e13",
    "color.muted": "#5a606e",
    "color.border": "#e2e4e9",
    "color.primary": "#193c61",
    "color.onPrimary": "#ffffff",
    "color.accent": "#2e6b57",
    "font.display": "'Manrope', sans-serif",
    "font.body": "'IBM Plex Sans', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "700",
    "radius.base": "6px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 2px rgb(12 14 19 / 0.06), 0 8px 24px rgb(12 14 19 / 0.06)",
    "space.base": "4px",
    "space.section": "84px",
    "motion.duration": "192ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1160px",
    "space.text": "680px"
  },
  "effects": {
