{
  "name": "Mastered",
  "words": "Navy, compact headings and ruled cards keep the numbers clear.",
  "mode": "light",
  "feel": [
    "serious",
    "modern"
  ],
  "tokens": {
    "icon.set": "heroicons:outline",
    "color.bg": "#fbfcfe",
    "color.surface": "#eef2f7",
    "color.text": "#0e1a2b",
    "color.muted": "#51607a",
    "color.border": "#d5dde8",
    "color.primary": "#193c61",
    "color.onPrimary": "#ffffff",
    "color.accent": "#2e6b57",
    "font.display": "'Manrope', sans-serif",
    "font.body": "'IBM Plex Sans', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.2",
    "type.displayWeight": "700",
    "radius.base": "6px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 0 rgb(14 26 43 / 0.04), 0 2px 6px rgb(14 26 43 / 0.08)",
    "space.base": "4px",
    "space.section": "84px",
    "motion.duration": "192ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1160px",
    "space.text": "680px"
  },
  "effects": {
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "primary",
          "accent"
        ],
        "angle": 180
      }
    }
  },
  "textStyles": {
    "label": {
      "weight": 700,
      "tracking": 0.04,
      "size": "xs"
    },
    "h1": {
      "tracking": -0.035,
      "leading": 1.05
    },
    "h2": {
      "tracking": -0.03,
      "leading": 1.1
    },
    "h3": {
      "weight": 700,
      "tracking": -0.02,
      "leading": 1.2
    },
    "h4": {
      "weight": 700,
      "tracking": -0.01,
      "leading": 1.25
    },
    "bodyLarge": {
      "leading": 1.5
    },
    "small": {
      "weight": 500,
      "leading": 1.45
    },
    "caption": {
      "font": "mono",
      "weight": 500,
      "tracking": 0
    }
  },
  "components": {
    "badge": {
      "variant": "outline"
    },
    "card": {
      "variant": "bordered"
    },
    "button": {
      "variant": "solid",
