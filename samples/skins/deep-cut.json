{
  "name": "Deep Cut",
  "words": "Mint on charcoal with tight type and a technical grid.",
  "mode": "dark",
  "feel": [
    "dark",
    "modern"
  ],
  "tokens": {
    "icon.set": "phosphor:bold",
    "color.bg": "#0e1110",
    "color.surface": "#171c1a",
    "color.text": "#e9efec",
    "color.muted": "#9aa5a0",
    "color.border": "#2a322f",
    "color.primary": "#a8f2db",
    "color.onPrimary": "#171717",
    "color.accent": "#e3baff",
    "font.display": "'Space Grotesk', sans-serif",
    "font.body": "'Geist', sans-serif",
    "font.mono": "'Geist Mono', ui-monospace, monospace",
    "type.base": "15px",
    "type.ratio": "1.25",
    "type.displayWeight": "700",
    "radius.base": "6px",
    "stroke.width": "1px",
    "shadow.card": "0 0 0 1px rgb(168 242 219 / 0.08), 0 16px 32px rgb(0 0 0 / 0.5)",
    "space.base": "4px",
    "space.section": "88px",
    "motion.duration": "176ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1280px",
    "space.text": "740px"
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 500,
      "tracking": 0,
      "upper": false,
      "size": "sm"
    },
    "h1": {
      "tracking": -0.045,
      "leading": 1
    },
    "h2": {
      "tracking": -0.04,
      "leading": 1.05
    },
    "h3": {
      "weight": 700,
      "tracking": -0.025,
      "leading": 1.15
    },
    "h4": {
      "weight": 500,
      "tracking": -0.015,
      "leading": 1.25
    },
    "bodyLarge": {
      "leading": 1.55
    },
    "small": {
      "font": "mono",
      "tracking": 0
    },
    "caption": {
      "font": "mono",
      "tracking": 0.08,
      "upper": true
    }
  },
  "components": {
    "badge": {
      "variant": "square"
    },
    "card": {
      "variant": "glow"
    },
    "button": {
