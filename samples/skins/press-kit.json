    "type.ratio": "1.333",
    "type.displayWeight": "400",
    "radius.base": "0px",
    "stroke.width": "1px",
    "shadow.card": "0 0 0 1px #2e2d33",
    "space.base": "4px",
    "space.section": "100px",
    "motion.duration": "256ms",
    "motion.ease": "cubic-bezier(0.16, 1, 0.3, 1)",
