{
  "name": "Liner Notes",
  "words": "Warm paper and oxblood ink, set like a magazine.",
  "mode": "light",
  "feel": [
    "classic",
    "warm",
    "calm"
  ],
  "tokens": {
    "icon.set": "iconoir:regular",
    "color.bg": "#f6f1e7",
    "color.surface": "#ece4d3",
    "color.text": "#1f1a14",
    "color.muted": "#6b6155",
    "color.border": "#d6c9b1",
    "color.primary": "#7a1f1f",
    "color.onPrimary": "#f6f1e7",
    "color.accent": "#c2602e",
    "font.display": "'Fraunces', Georgia, serif",
    "font.body": "'Newsreader', Georgia, serif",
    "font.mono": "'IBM Plex Mono', ui-monospace, monospace",
    "type.base": "18px",
    "type.ratio": "1.333",
    "type.displayWeight": "380",
    "radius.base": "2px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 0 #d6c9b1",
    "space.base": "4px",
    "space.section": "112px",
    "motion.duration": "280ms",
    "motion.ease": "cubic-bezier(0.33, 1, 0.68, 1)",
    "space.content": "1236px",
    "space.text": "692px"
  },
  "effects": {
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 0
      }
    },
    "grain": {
      "id": "grain",
      "params": {
        "amount": 10,
        "size": 0.7
      }
    },
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "surface",
          "bg"
        ],
        "angle": 180
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "body",
      "weight": 600,
      "tracking": 0.1
    },
    "h1": {
      "tracking": -0.025,
      "leading": 1.04,
      "phone": "3xl"
    },
    "h2": {
      "tracking": -0.02,
      "leading": 1.1,
      "phone": "xl"
    },
    "h3": {
      "weight": 400,
      "tracking": -0.01,
      "leading": 1.22,
      "phone": "lg"
    },
    "h4": {
      "weight": 600,
      "tracking": 0,
      "leading": 1.3
    },
    "bodyLarge": {
      "leading": 1.5
    },
    "small": {
      "leading": 1.5
    },
    "caption": {
      "tracking": 0.02
    }
  },
  "components": {
    "badge": {
      "variant": "line"
    },
    "card": {
      "variant": "rule"
    },
    "button": {
      "variant": "solid",
      "secondary": {
        "variant": "arrow"
      }
    },
    "icon": {
      "variant": "bare"
    },
    "link": {
      "variant": "underline"
    },
    "input": {
      "variant": "underline"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "grain"
      },
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "features": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "testimonials": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "blur",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "surface": "brand",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "nav": {
      "backdrop": {
        "id": "grain"
      }
    }
  },
  "picture": {
    "style": "print-edition",
    "subjects": [
      "print-edition",
      "reading-room",
      "print-studio"
    ],
    "mode": "image"
  },
  "industries": [
    "media",
    "nonprofit"
  ]
}
