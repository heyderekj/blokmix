    "font.mono": "'DM Mono', ui-monospace, monospace",
    "type.base": "17px",
    "type.ratio": "1.25",
    "type.displayWeight": "400",
    "radius.base": "16px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 2px rgb(43 33 25 / 0.06), 0 10px 30px rgb(43 33 25 / 0.08)",
