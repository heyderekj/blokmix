{
  "name": "Lo-fi",
  "words": "Cream and terracotta, cozy as a Sunday café.",
  "mode": "light",
  "feel": [
    "warm",
    "playful",
    "calm"
  ],
  "tokens": {
    "icon.set": "phosphor:duotone",
    "color.bg": "#fbf6ee",
    "color.surface": "#f4eadb",
    "color.text": "#2b2119",
    "color.muted": "#6f5f50",
    "color.border": "#e6d8c4",
    "color.primary": "#b84a22",
    "color.onPrimary": "#fffaf3",
    "color.accent": "#5d7a3a",
    "font.display": "'Young Serif', Georgia, serif",
