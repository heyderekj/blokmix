{
  "name": "Vinyl",
  "words": "Black and ivory with fine serif type, set like a gallery.",
  "mode": "dark",
  "feel": [
    "dark",
    "classic",
    "serious"
  ],
  "tokens": {
    "icon.set": "phosphor:thin",
    "color.bg": "#0f0e0c",
    "color.surface": "#1a1815",
    "color.text": "#f2ece0",
    "color.muted": "#a39a8b",
    "color.border": "#322d26",
    "color.primary": "#efe6d4",
    "color.onPrimary": "#13110e",
    "color.accent": "#c9a46a",
    "font.display": "'Instrument Serif', Georgia, serif",
    "font.body": "'Hanken Grotesk', system-ui, sans-serif",
    "font.mono": "'DM Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.333",
    "type.displayWeight": "400",
    "radius.base": "0px",
    "stroke.width": "1px",
    "shadow.card": "none",
    "space.base": "4px",
    "space.section": "128px",
    "motion.duration": "280ms",
    "motion.ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "space.content": "1308px",
    "space.text": "716px"
  },
  "effects": {
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 0
      }
    },
    "grain": {
      "id": "grain",
      "params": {
        "amount": 8,
        "size": 0.8
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 400,
      "tracking": 0.16
    },
    "h1": {
      "tracking": -0.02,
      "leading": 1,
      "phone": "3xl"
    },
    "h2": {
      "tracking": -0.015,
      "leading": 1.08,
      "phone": "2xl"
    },
    "h3": {
      "tracking": -0.005,
      "leading": 1.2,
      "phone": "xl"
    },
    "h4": {
      "font": "body",
      "weight": 500,
      "tracking": 0.01,
      "leading": 1.4
    },
    "bodyLarge": {
      "leading": 1.6
    },
    "small": {
      "tracking": 0.01
    },
    "caption": {
      "tracking": 0.1,
      "upper": true
    }
  },
  "components": {
    "badge": {
      "variant": "line"
    },
    "card": {
      "variant": "flat"
    },
    "button": {
      "variant": "caps",
      "secondary": {
        "variant": "arrow"
      }
    },
    "icon": {
      "variant": "bare"
    },
    "link": {
      "variant": "quiet"
    },
    "input": {
      "variant": "underline"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "spotlight",
        "params": {
          "color": "accent",
          "strength": 16,
          "x": 72,
          "size": 70,
          "anchor": "full",
          "reach": 100
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "blur",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "features": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "testimonials": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
