{
  "name": "Vinyl",
  "words": "Black and ivory with fine serif type, set like a gallery.",
  "mode": "dark",
  "feel": [
    "dark",
    "classic",
    "serious"
  ],
  "tokens": {
    "icon.set": "iconoir:light",
    "color.bg": "#0f0e0c",
    "color.surface": "#1a1815",
    "color.text": "#f2ece0",
    "color.muted": "#a39a8b",
    "color.border": "#322d26",
    "color.primary": "#efe6d4",
    "color.onPrimary": "#13110e",
    "color.accent": "#c9a46a",
    "font.display": "'Instrument Serif', Georgia, serif",
    "font.body": "'Hanken Grotesk', system-ui, sans-serif",
    "font.mono": "'DM Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.333",
    "type.displayWeight": "400",
    "radius.base": "0px",
    "stroke.width": "1px",
    "shadow.card": "none",
    "space.base": "4px",
    "space.section": "128px",
    "motion.duration": "600ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)"
  },
  "effects": {
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 0
      }
    },
    "grain": {
      "id": "grain",
      "params": {
        "amount": 8,
        "size": 0.8
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 400,
      "tracking": 0.16
    }
  },
  "components": {
    "badge": {
      "variant": "line"
    },
    "card": {
      "variant": "rule"
    },
    "button": {
      "secondary": {
        "variant": "arrow"
      }
    },
    "icon": {
      "variant": "bare"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "spotlight",
        "params": {
          "color": "accent",
          "strength": 16,
          "x": 72,
          "size": 70,
          "anchor": "full",
          "reach": 100
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "features": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "testimonials": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "faq": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "cta": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    }
  },
  "picture": {
    "style": "grain-gradient",
    "params": {
      "a": "accent",
      "b": "bg",
      "c": "primary",
      "angle": 200,
      "grain": 40
    }
  }
}
