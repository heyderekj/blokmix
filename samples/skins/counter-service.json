{
  "name": "Counter Service",
  "words": "Butter paper, tomato ink and pickup tickets from the bakery counter.",
  "mode": "light",
  "feel": [
    "warm",
    "classic"
  ],
  "tokens": {
    "icon.set": "phosphor:regular",
    "color.bg": "#fff6d7",
    "color.surface": "#ffebaf",
    "color.text": "#322318",
    "color.muted": "#735644",
    "color.border": "#c4a871",
    "color.primary": "#c8321a",
    "color.onPrimary": "#fff9e7",
    "color.accent": "#d95021",
    "font.display": "'Fraunces', Georgia, serif",
