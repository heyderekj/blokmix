    "font.mono": "'IBM Plex Mono', ui-monospace, monospace",
    "type.base": "18px",
    "type.ratio": "1.333",
    "type.displayWeight": "650",
    "radius.base": "8px",
    "stroke.width": "1px",
    "shadow.card": "2px 3px 0 #dcc596",
    "space.base": "4px",
    "space.section": "80px",
    "motion.duration": "280ms",
