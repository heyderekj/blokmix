      }
    },
    "icon": {
      "variant": "tinted"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "grid",
        "params": {
          "gap": 56,
          "strength": 9,
          "anchor": "top",
          "reach": 75
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "normal"
