{
  "name": "Studio",
  "words": "Crisp and sure: white, near-black, one bright blue.",
  "tier": "free",
  "mode": "light",
  "feel": [
    "calm",
    "modern",
    "serious"
  ],
  "tokens": {
    "icon.set": "lucide:regular",
    "color.bg": "#ffffff",
    "color.surface": "#f4f5f7",
    "color.text": "#0c0e13",
    "color.muted": "#5a606e",
    "color.border": "#e2e4e9",
    "color.primary": "#0c0e13",
    "color.onPrimary": "#ffffff",
    "color.accent": "#3a5bf7",
    "font.display": "'General Sans', system-ui, sans-serif",
    "font.body": "'Inter', system-ui, sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "600",
    "radius.base": "10px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 2px rgb(12 14 19 / 0.06), 0 8px 24px rgb(12 14 19 / 0.06)",
    "space.base": "4px",
    "space.section": "112px",
    "motion.duration": "280ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)"
  },
  "effects": {
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "accent",
          "primary"
        ],
        "angle": 135
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 500,
      "tracking": 0.08
    }
  },
