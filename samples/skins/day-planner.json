{
  "name": "Day Planner",
  "words": "Cobalt type, lilac paper and compact program cards for a day of events.",
  "mode": "light",
  "feel": [
    "modern",
    "playful"
  ],
  "tokens": {
    "icon.set": "heroicons:solid",
    "color.bg": "#f6f3ff",
    "color.surface": "#e7dfff",
    "color.text": "#22234a",
    "color.muted": "#575579",
    "color.border": "#aaa1cb",
    "color.primary": "#323fa7",
    "color.onPrimary": "#ffffff",
    "color.accent": "#6b43dd",
    "font.display": "'Big Shoulders Display', sans-serif",
    "font.body": "'Inter', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.2",
    "type.displayWeight": "800",
    "radius.base": "5px",
    "stroke.width": "1px",
    "shadow.card": "0 2px 0 #c9bfeb",
    "space.base": "4px",
    "space.section": "72px",
    "motion.duration": "272ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1280px",
    "space.text": "640px"
  },
  "textStyles": {
    "label": {
      "font": "display",
      "weight": 600,
      "tracking": 0.08,
      "size": "sm"
    },
    "h1": {
      "tracking": 0.005,
      "leading": 0.95,
      "upper": true
    },
    "h2": {
      "tracking": 0.01,
      "leading": 1,
      "upper": true
    },
    "h3": {
      "weight": 600,
      "tracking": 0.02,
      "leading": 1.1,
      "upper": true
    },
    "h4": {
      "font": "body",
      "weight": 600,
      "tracking": -0.005,
      "leading": 1.25
    },
    "bodyLarge": {
      "leading": 1.5
    },
    "small": {
      "weight": 500
    },
    "caption": {
      "weight": 600,
      "tracking": 0.04,
      "upper": true
    }
  },
  "industries": [
    "events",
    "education"
  ],
  "components": {
    "badge": {
      "variant": "square"
    },
    "card": {
      "variant": "tinted"
    },
    "icon": {
      "variant": "tinted"
    },
    "button": {
      "variant": "caps",
      "secondary": {
        "variant": "outline"
      }
    },
    "input": {
      "variant": "filled"
    },
    "link": {
      "variant": "underline"
    },
    "heading": {
      "variant": "caps"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "grid",
        "params": {
          "gap": 50,
          "strength": 8
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "slide",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "stats": {
      "surface": "brand",
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "features": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "cta": {
      "surface": "inverse",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "testimonials": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    }
  },
  "picture": {
    "style": "grid",
    "subjects": [
      "day-ticket",
      "calendar",
      "print-edition",
      "form"
    ],
    "mode": "ui",
    "mockParams": {
      "chrome": "none",
      "tint": true,
      "shadow": false
    }
  }
}
