{
  "name": "Supper Club",
  "words": "Candlelit and unhurried: a dark dining room, brass and a printed menu.",
  "mode": "dark",
  "feel": [
    "dark",
    "warm",
    "classic"
  ],
  "tokens": {
    "icon.set": "material:light",
    "color.bg": "#17110e",
    "color.surface": "#231a15",
    "color.text": "#f3e9dc",
    "color.muted": "#bba995",
    "color.border": "#3b2d25",
    "color.primary": "#d9a75b",
    "color.onPrimary": "#1a120d",
    "color.accent": "#d0684b",
    "font.display": "'Bodoni Moda', Didot, 'Times New Roman', serif",
    "font.body": "'Karla', system-ui, sans-serif",
    "font.mono": "'DM Mono', ui-monospace, monospace",
    "type.base": "17px",
    "type.ratio": "1.333",
    "type.displayWeight": "400",
    "radius.base": "4px",
    "stroke.width": "1px",
    "shadow.card": "0 1px 0 rgb(0 0 0 / 0.4), 0 18px 40px rgb(0 0 0 / 0.35)",
    "space.base": "4px",
    "space.section": "120px",
    "space.content": "1180px",
    "space.text": "660px",
    "motion.duration": "280ms",
    "motion.ease": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "effects": {
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 0
      }
    },
    "grain": {
      "id": "grain",
      "params": {
        "amount": 8,
        "size": 0.8
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "body",
      "weight": 500,
      "tracking": 0.24,
      "size": "xs"
    },
    "h1": {
      "weight": 400,
      "tracking": -0.01,
      "leading": 1.04,
      "phone": "3xl"
    },
    "h2": {
      "weight": 400,
      "tracking": -0.005,
      "leading": 1.1,
      "phone": "2xl"
    },
    "h3": {
      "weight": 400,
      "tracking": 0,
      "leading": 1.2,
      "phone": "xl"
    },
    "h4": {
      "weight": 400,
      "tracking": 0.005,
      "leading": 1.25
