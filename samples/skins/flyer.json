{
  "name": "Flyer",
  "words": "Loud: black rules, hi-vis yellow, no corners.",
  "mode": "light",
  "feel": [
    "bold",
    "playful"
  ],
  "tokens": {
    "icon.set": "tabler:bold",
    "color.bg": "#ffffff",
    "color.surface": "#f2f2ee",
    "color.text": "#000000",
    "color.muted": "#555555",
    "color.border": "#000000",
    "color.primary": "#ffe600",
    "color.onPrimary": "#000000",
    "color.accent": "#ff3b00",
    "font.display": "'Archivo Black', 'Arial Black', sans-serif",
    "font.body": "'Archivo', system-ui, sans-serif",
    "font.mono": "'Space Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.25",
    "type.displayWeight": "400",
    "radius.base": "0px",
    "stroke.width": "2px",
    "shadow.card": "6px 6px 0 #000000",
    "space.base": "4px",
    "space.section": "80px",
    "motion.duration": "140ms",
    "motion.ease": "cubic-bezier(0.23, 1, 0.32, 1)",
    "space.content": "1200px",
    "space.text": "680px"
  },
  "effects": {
    "grain": {
      "id": "grain",
      "params": {
        "amount": 36,
        "size": 1.8,
        "color": "primary"
      }
    },
    "shadow": {
      "id": "shadow",
      "params": {
        "elevation": 6,
        "softness": 0,
        "layers": 1,
        "opacity": 60,
        "tighten": 0,
        "angle": 135,
        "tint": "primary"
      }
    },
    "gradient": {
      "id": "gradient",
      "params": {
        "stops": [
          "accent",
          "primary"
        ],
        "angle": 90,
        "smooth": false
      }
    }
  },
  "textStyles": {
    "label": {
      "font": "mono",
      "weight": 700,
      "tracking": 0.04,
      "size": "sm"
    },
    "h1": {
      "tracking": -0.03,
      "leading": 0.95,
      "upper": true
    },
    "h2": {
      "tracking": -0.03,
      "leading": 1,
      "upper": true
    },
    "h3": {
      "tracking": -0.02,
      "leading": 1.1,
      "upper": true
    },
    "h4": {
      "font": "body",
      "weight": 800,
      "tracking": 0.02,
      "leading": 1.2,
      "upper": true
    },
    "bodyLarge": {
      "weight": 500,
      "leading": 1.45
    },
    "small": {
      "weight": 500
    },
    "caption": {
      "font": "mono",
      "weight": 700,
      "tracking": 0.04,
      "upper": true
    }
  },
  "components": {
    "badge": {
      "variant": "square"
    },
    "card": {
      "variant": "bordered"
    },
    "button": {
      "variant": "offset",
      "secondary": {
        "variant": "outline"
      }
    },
    "heading": {
      "variant": "caps"
    },
    "icon": {
      "variant": "bare"
    },
    "link": {
      "variant": "underline"
    },
    "input": {
      "variant": "underline"
    }
  },
  "sections": {
    "hero": {
      "surface": "brand",
      "motion": {
        "mode": "preset",
        "enter": "drop",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "testimonials": {
      "surface": "inverse",
      "motion": {
        "mode": "preset",
        "enter": "slide",
        "onScroll": true,
        "speed": "quick"
      }
    },
    "nav": {
      "surface": "brand"
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "pop",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "drop",
        "stagger": true,
        "onScroll": true,
        "speed": "quick"
      }
    },
    "cta": {
