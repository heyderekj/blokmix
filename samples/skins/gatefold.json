{
  "name": "Gatefold",
  "words": "Broad margins, stone tones and fine rules frame the work.",
  "mode": "light",
  "feel": [
    "classic",
    "calm"
  ],
  "tokens": {
    "icon.set": "lucide:light",
    "color.bg": "#faf9f6",
    "color.surface": "#efede7",
    "color.text": "#1b1c19",
    "color.muted": "#62625a",
    "color.border": "#dbd8cf",
    "color.primary": "#272d2a",
    "color.onPrimary": "#ffffff",
    "color.accent": "#766946",
    "font.display": "'Playfair Display', serif",
    "font.body": "'Inter', sans-serif",
    "font.mono": "'JetBrains Mono', ui-monospace, monospace",
    "type.base": "16px",
    "type.ratio": "1.333",
    "type.displayWeight": "600",
    "radius.base": "0px",
    "stroke.width": "1px",
    "shadow.card": "none",
    "space.base": "4px",
    "space.section": "120px",
    "motion.duration": "160ms",
    "motion.ease": "cubic-bezier(0.16, 1, 0.3, 1)",
    "space.content": "1400px",
    "space.text": "660px"
  },
  "textStyles": {
    "label": {
      "weight": 500,
      "tracking": 0.18
    },
    "h1": {
      "tracking": -0.015,
      "leading": 1.05,
      "phone": "3xl"
    },
    "h2": {
      "tracking": -0.01,
      "leading": 1.1,
      "phone": "2xl"
    },
    "h3": {
      "weight": 400,
      "tracking": 0,
      "leading": 1.25,
      "phone": "xl"
    },
    "h4": {
      "font": "body",
      "weight": 600,
      "tracking": 0.01,
      "leading": 1.35
    },
    "bodyLarge": {
      "leading": 1.6
    },
    "small": {
      "tracking": 0.01
    },
    "caption": {
      "weight": 500,
      "tracking": 0.08,
      "upper": true
    }
  },
  "components": {
    "badge": {
      "variant": "mono"
    },
    "card": {
      "variant": "rule"
    },
    "button": {
      "variant": "caps",
      "secondary": {
        "variant": "arrow"
      }
    },
    "icon": {
      "variant": "ring"
    },
    "link": {
      "variant": "sweep"
    },
    "input": {
      "variant": "underline"
    }
  },
  "sections": {
    "hero": {
      "backdrop": {
        "id": "lines",
        "params": {
          "strength": 8
        }
      },
      "motion": {
        "mode": "preset",
        "enter": "blur",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "features": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "testimonials": {
      "surface": "soft",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "pricing": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "faq": {
      "motion": {
        "mode": "none"
      }
    },
    "cta": {
      "surface": "inverse",
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "stats": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true
      }
    },
    "team": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "blog": {
      "motion": {
        "mode": "preset",
        "enter": "rise",
        "stagger": true,
        "onScroll": true
      }
    },
    "gallery": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "stagger": true,
        "onScroll": true,
        "speed": "slow"
      }
    },
    "contact": {
      "motion": {
        "mode": "preset",
        "enter": "fade",
        "onScroll": true,
        "speed": "slow"
      }
    },
    "content": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    },
    "logos": {
      "motion": {
        "mode": "preset",
        "enter": "fade"
      }
    }
  },
  "picture": {
    "style": "arch",
    "subjects": [
      "courtyard",
      "print-edition",
      "reading-room",
      "cards"
    ],
    "mode": "image"
  },
  "industries": [
    "architecture",
    "agency"
  ],
  "formats": [
    "portfolio"
  ],
  "flavors": [
    {
      "id": "exhibition",
      "name": "Gatefold · Exhibition",
      "industry": "agency",
      "parts": {
        "pictures": "vinyl"
      }
    }
  ]
}
